{
  "name": "@ai4paper/dsh-ipaper-root",
  "version": "0.1.2",
  "private": true,
  "description": "IPaper DSH product workspace",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "workspaces": ["packages/*"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "build": "pnpm -r --if-present run build:package",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "pack:check": "node scripts/pack-check.mjs",
    "browser:check": "node scripts/browser-check.mjs",
    "dev": "pnpm dev:install && node scripts/dev.mjs",
    "dev:config": "DSH_HOME=\"$HOME/.ipaper\" pnpm --dir \"$HOME/.ipaper/profiles/ipaper-dev\" exec dsh --profile ipaper-dev --dump-config",
    "dev:install": "node scripts/dev-install.mjs",
    "dev:remove": "DSH_HOME=\"$HOME/.ipaper\" pnpm --dir \"$HOME/.ipaper/profiles/ipaper-dev\" exec dsh plugin --profile ipaper-dev remove @ai4paper/dsh-ipaper @deepseek-ai/dsh-base @deepseek-ai/dsh-web-app @ai4paper/apaper-plugin"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "@ai4paper/apaper-plugin": "0.2.3",
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-base": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web-app": "0.2.2-rc.1"
  }
}
