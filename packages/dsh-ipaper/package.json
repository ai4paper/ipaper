{
  "name": "@ai4paper/dsh-ipaper",
  "version": "0.1.2",
  "description": "Academic paper-writing Web product bundle for DeepSeek Harness",
  "keywords": ["ipaper", "academic-writing", "deepseek-harness", "dsh", "dsh-plugin", "research", "scholarly-writing"],
  "publishConfig": { "access": "public" },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./connection": { "types": "./lib/types/connection.d.ts", "default": "./lib/connection.js" },
    "./academic-writing-preset": { "types": "./lib/types/academic-writing-preset.d.ts", "default": "./lib/academic-writing-preset.js" },
    "./paper-project": { "types": "./lib/types/paper-project/index.d.ts", "default": "./lib/paper-project/index.js" },
    "./paper-project-remote": { "types": "./lib/types/paper-project-remote.d.ts", "default": "./lib/paper-project-remote.js" },
    "./paper-project-tools": { "types": "./lib/types/paper-project/tools.d.ts", "default": "./lib/paper-project/tools.js" },
    "./product-protocol": { "types": "./lib/types/product-protocol.d.ts", "default": "./lib/product-protocol.js" },
    "./ipaper-skills": { "types": "./lib/types/ipaper-skills.d.ts", "default": "./lib/ipaper-skills.js" },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/web/**",
    "!lib/**/*.js.map",
    "cordis.patch.yml",
    "preset/ipaper/**",
    "skills/**",
    "README.md"
  ],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "repository": { "type": "git", "url": "git+https://github.com/ai4paper/ipaper.git", "directory": "packages/dsh-ipaper" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "pnpm build:package",
    "build:package": "node scripts/clean.mjs && tsc -p tsconfig.json && pnpm build:brand && node scripts/copy-product-assets.mjs",
    "build:brand": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "pnpm build:package && node --test tests/*.test.mjs",
    "prepack": "pnpm build:package"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
